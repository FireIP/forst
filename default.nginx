# Include this file in nginx's http context. The cache directory must be writable by nginx.
proxy_cache_path /var/cache/nginx/forst-live levels=1:2 keys_zone=forst_live:1m
                 max_size=10m inactive=1m;

server {
    listen 8090;
    server_name <domain>;

    root /var/www/stream;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /thumbs/ {
        alias /srv/ome-thumbs/;
        autoindex off;
        expires 30s;
        add_header Cache-Control "public, must-revalidate";
    }

    # Only expose stream lists, never the full OME management API.
    location ~ ^/api/live/(?<ome_app>[A-Za-z0-9_-]+)$ {
        if ($request_method != GET) { return 405; }
        proxy_pass http://127.0.0.1:8081/v1/vhosts/default/apps/$ome_app/streams;
        # Replace with base64 of the OME Managers/API/AccessToken (no newline).
        proxy_set_header Authorization "Basic <base64-of-OME-AccessToken>";
        proxy_set_header Host $proxy_host;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_hide_header WWW-Authenticate;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        proxy_cache forst_live;
        proxy_cache_key "$host$uri";
        proxy_cache_valid 200 2s;
        proxy_cache_lock on;
        add_header Cache-Control "no-store";
    }

    location /api/live/ {
        return 404;
    }

    location = /selftest/ {
        return 301 /selftest;
    }
    
    location = /selftest {
        alias /var/www/stream/webrtc-h264-selftest.html;
        default_type text/html;
    }
    
    location ^~ /selftest/ {
        return 301 /selftest;
    }

    location ^~ /app/ {
        proxy_pass http://127.0.0.1:3333;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 7200s;
        proxy_send_timeout 7200s;
        proxy_read_timeout 7200s;
        proxy_buffering off;
        proxy_cache off;
        proxy_buffer_size 4k;
        proxy_buffers 4 4k;
        proxy_busy_buffers_size 8k;
    }

    location /lib/ {
        alias /var/www/ome-site/lib/;
        expires 7d;
    }

    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy no-referrer-when-downgrade;
    add_header Content-Security-Policy "default-src 'self' 'unsafe-inline' data: blob: https: ws: wss:; connect-src 'self' https: ws: wss: http://127.0.0.1:9090; img-src 'self' data: https:;";
}
